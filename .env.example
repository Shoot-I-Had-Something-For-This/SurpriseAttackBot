# Copy to .env and fill in real values.
# Never share .env — only share .env.example and the docs.
#
# SA_CHANNEL_ID is per Discord server. Your test channel ID will NOT work
# on someone else's server — they must paste their own #sa-live channel ID.
# After changing it, restart the bot and run !sa where in that channel.

DISCORD_TOKEN=your_bot_token_here

# The ONE channel for submissions + live board
SA_CHANNEL_ID=123456789012345678

# Optional: Discord role IDs that can run !sa start / !sa end
# Comma-separated. Anyone with Manage Server can always operate.
# SA_OPERATOR_ROLE_IDS=111111111111111111,222222222222222222

# How many rows per mode on the live board
SA_LEADERBOARD_LIMIT=10

# Optional: read scoreboard screenshots (same as Indies score bot)
# Without this, only Discord → Submit Score embeds work.
# GEMINI_API_KEY=your_gemini_api_key

# Required for the Vercel public leaderboard site
# (https://surprise-attack-leaderboard.vercel.app)
# Set these on Render Environment as well.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
